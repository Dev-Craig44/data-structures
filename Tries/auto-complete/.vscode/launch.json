{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "node",
      "request": "launch",
      "name": "Debug TS with ts-node",
      "skipFiles": ["<node_internals>/**", "**/node_modules/**"],
      "smartStep": true,
      "program": "${workspaceFolder}/src/index.ts",
      "runtimeArgs": ["-r", "ts-node/register"],
      "cwd": "${workspaceFolder}"
    },

    {
      "type": "node",
      "request": "launch",
      "name": "Run ts-node",
      "runtimeExecutable": "ts-node",
      "cwd": "${workspaceFolder}",
      "args": []
    }
  ]
}
